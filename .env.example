# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB (MongoDB Atlas or Railway MongoDB service)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/hassanpro?retryWrites=true&w=majority
MONGODB_URI=""

# Optional: MongoDB Database Name (defaults to hassanpro_chat if not set)
MONGODB_DB_NAME="hassanpro_chat"

# PORT: Server port (defaults to 3000, Railway automatically sets this)
PORT=3000

# VITE_SERVER_URL: Only needed if Frontend is hosted on Vercel and Backend is on Railway
# Example: https://hassanpro-production.up.railway.app
# Leave empty if Frontend and Backend are hosted together on Railway!
VITE_SERVER_URL=""
